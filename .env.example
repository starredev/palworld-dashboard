# =============================================================================
#  Tsuki Panel — environment configuration
# =============================================================================

# ---- API ----
API_HOST=0.0.0.0
API_PORT=4000
# Timezone for scheduled restarts & config events (times are container-local).
TZ=Europe/Amsterdam
# CORS is only used in local dev; production is same-origin behind nginx.
CORS_ORIGIN=http://localhost:5173

# ---- Auth: bootstrap admin ----
# Password admin — always works, never locked out.
AUTH_PASSWORD=
# Session-signing secret (min 16 chars). ⚠️ STILL THE INSECURE DEFAULT — CHANGE IT:
#   openssl rand -hex 32
JWT_SECRET=dev-insecure-secret-change-me-please
COOKIE_NAME=tsuki_session
SESSION_TTL=7d
# Set to true once you're sure the panel is only reached over HTTPS.
COOKIE_SECURE=false

# ---- Auth: Discord OAuth (role-based) ----
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
# Your Discord server (required for role-based access).
DISCORD_GUILD_ID=
# This role → admin (full access). Any other member = viewer.
DISCORD_ADMIN_ROLE_IDS=
# Optional: only these roles may sign in at all (empty = any member = viewer).
# DISCORD_ALLOWED_ROLE_IDS=

# ---- Palworld connection ----
# REST is preferred; RCON is the fallback (your server has RCON disabled, so
# the RCON block below is effectively unused — kept for reference).
PALWORLD_REST_URL=http://palworld-server:8212
PALWORLD_REST_USERNAME=admin
PALWORLD_REST_PASSWORD=
# External Docker network of the game container (for the compose.palworld overlay).
PALWORLD_NETWORK=palworld_default
# Game container name — needed for save writing & the docker-logs source.
PALWORLD_CONTAINER=palworld-server
# Host docker group id so the non-root API can use the mounted socket.
DOCKER_GID=107

# RCON (fallback; currently unused)
PALWORLD_RCON_HOST=127.0.0.1
PALWORLD_RCON_PORT=25575
PALWORLD_RCON_PASSWORD=

# ---- Save editing, live config & backups ----
# Host path of the game data dir (mounted into the API by compose.palworld.yml).
PALWORLD_DATA_DIR=/home/palworld/palworld
# Auto-backups (needs the data mount). 0 = off.
BACKUP_SCHEDULE_HOURS=6
BACKUP_RETENTION=7
# PALWORLD_LOG_PATH / PALWORLD_SAVE_DIR use sensible defaults under the mount.

# ---- Map, guilds & branding ----
LIVEMAP_URL=https://pal.map.starre.dev/
GAMEDATA_URL=http://palworld-live-map:8080
MAP_IMAGE_URL=https://raw.githubusercontent.com/LukeHollandDev/palworld-live-map/main/assets/palworld/maps/palpagos.jpg
# HEADER_IMAGE_URL=/brand/header.jpg

# ---- Dashboard ----
# The dashboard calls the API same-origin at /api, so you normally leave this unset.
# VITE_API_URL=/api

# ---- Docker Compose deployment ----
# Public port nginx (the dashboard) listens on; your reverse proxy fronts TLS.
HTTP_PORT=8080
# Always load all three compose files — so you can't forget an overlay.
COMPOSE_FILE=compose.yml:compose.palworld.yml:compose.docs.yml

# ---- API (apps/api) ----
API_HOST=0.0.0.0
API_PORT=4000
# Timezone for scheduled restarts & config events (times are local to the api
# container). Defaults to UTC. Example:
# TZ=Europe/Amsterdam
# Comma-separated list of allowed origins for CORS
CORS_ORIGIN=http://localhost:5173

# ---- Auth (bootstrap admin password + optional Discord OAuth) ----
# Bootstrap admin password — always works, so you're never locked out. CHANGE THIS.
AUTH_PASSWORD=admin
# Secret used to sign session JWTs (min 16 chars). CHANGE THIS in production.
JWT_SECRET=dev-insecure-secret-change-me-please
COOKIE_NAME=tsuki_session
SESSION_TTL=7d

# ---- Discord login (optional) ----
# Let people sign in with Discord. Create an app at
# https://discord.com/developers/applications → OAuth2. Add a redirect that
# matches DISCORD_REDIRECT_URI exactly. All three below are required to enable it.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_REDIRECT_URI=https://your-panel-domain/api/auth/discord/callback
# Your Discord server (guild) id. Required for role-based access.
# DISCORD_GUILD_ID=987654321098765432
#
# --- Role-based access (recommended) ---
# Members with an admin ROLE get full access; everyone else allowed = viewer.
# DISCORD_ADMIN_ROLE_IDS=111111111111111111
# Optional: only members with one of these roles may sign in at all (leave empty
# to let any member of the guild sign in as a viewer).
# DISCORD_ALLOWED_ROLE_IDS=222222222222222222
#
# --- Or by user id (extra/fallback, combined with the above) ---
# DISCORD_ALLOWED_IDS=111111111111111111,222222222222222222
# DISCORD_ADMIN_IDS=111111111111111111
#
# If NEITHER a guild nor an id allowlist is set, Discord login is refused
# (the password admin always still works).

# ---- Palworld server connection (packages/sdk) ----
# Configure REST and/or RCON. The API prefers REST and falls back to RCON.
# Leave a block blank to disable that transport; leave BOTH blank and the panel
# shows a "connect your server" state instead of live data.

# REST API (recommended) — requires RESTAPIEnabled=True + AdminPassword on the server.
# PALWORLD_REST_URL=http://127.0.0.1:8212
PALWORLD_REST_USERNAME=admin
PALWORLD_REST_PASSWORD=

# RCON — requires RCONEnabled=True + AdminPassword on the server.
PALWORLD_RCON_HOST=
PALWORLD_RCON_PORT=25575
PALWORLD_RCON_PASSWORD=

# If the Palworld server runs in Docker on the same host and its REST port
# (8212) is NOT published, connect Tsuki to its network with the overlay:
#   docker compose -f compose.yml -f compose.palworld.yml up -d --build
# Then use the service/container name as the host and set the network name:
# PALWORLD_REST_URL=http://palworld-server:8212
# PALWORLD_NETWORK=palworld_default
# To edit PalWorldSettings.ini live from the Config page, point this at the game
# server's data dir on the host (the dir its container mounts). Restart applies
# via the server's own shutdown + your container's restart policy.
# PALWORLD_DATA_DIR=/home/palworld/server/palworld

# Auto-backup schedule (needs PALWORLD_DATA_DIR). 0 = disabled.
# BACKUP_SCHEDULE_HOURS=6
# BACKUP_RETENTION=7

# --- Logs page ---
# If your server writes a log FILE, point at it (inside the api container):
# PALWORLD_LOG_PATH=/palworld-data/Pal/Saved/Logs/Pal.log
# If it only logs to stdout (e.g. thijsvanloef image), set the game container's
# name to read `docker logs` instead. compose.palworld.yml mounts the socket
# read-only for this. Example:
# PALWORLD_CONTAINER=palworld-server
# The non-root api needs the host's docker group gid to read the socket.
# Find it with:  getent group docker
# DOCKER_GID=999

# Guilds & Pals: point the API at your live-map's GameData API (internal URL).
# The api reaches the live-map container on the shared network.
# GAMEDATA_URL=http://palworld-live-map:8080
# GAMEDATA_STATE_PATH=/api/state
# GAMEDATA_OBJECTS_PATH=/api/objects
# Optional: a full Palpagos map image (north-up, covering the whole map) shown
# as the background of the built-in Map. Markers align to the .sav coord bounds.
# MAP_IMAGE_URL=https://example.com/palworld-map.webp

# ---- Live map ----
# Banner image shown across the dashboard top bar, to brand your panel.
# Any image URL, or a file you drop in apps/dashboard/public (e.g. put it at
# apps/dashboard/public/brand/header.jpg and set the value to /brand/header.jpg).
# HEADER_IMAGE_URL=/brand/header.jpg

# Absolute URL of your palworld-live-map, embedded on the Map page.
# Served to the browser at runtime (no rebuild needed — just restart the api).
# Empty => the dashboard falls back to the same host on port 3001.
LIVEMAP_URL=https://pal.map.starre.dev/

# ---- Dashboard (apps/dashboard) ----
# The dashboard calls the API same-origin at `/api` (Vite proxies it in dev,
# nginx proxies it in prod), so you normally DON'T need to set this.
# Only set it to an absolute URL if the API lives on a separate host.
# VITE_API_URL=/api

# ---- Docker Compose deployment (docker compose up -d --build) ----
# Public port nginx (the dashboard) listens on. 80 for http; front it with TLS for prod.
HTTP_PORT=80
# Set to "true" ONLY when the panel is served over HTTPS, so session cookies are Secure.
COOKIE_SECURE=false
